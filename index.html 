    <!-- Script Engine -->
    <script>
        let currentUser = localStorage.getItem('emon_logged_user');
        let coins = localStorage.getItem('emon_coins') ? parseInt(localStorage.getItem('emon_coins')) : 100;
        let generatedOtp = "";

        if (currentUser) {
            startApp(currentUser);
        }

        function showRegister() {
            document.getElementById('loginForm').classList.add('hidden');
            document.getElementById('otpForm').classList.add('hidden');
            document.getElementById('registerForm').classList.remove('hidden');
            document.getElementById('authSubTitle').innerText = "নতুন একাউন্ট তৈরি করুন";
        }

        function showLogin() {
            document.getElementById('registerForm').classList.add('hidden');
            document.getElementById('otpForm').classList.add('hidden');
            document.getElementById('loginForm').classList.remove('hidden');
            document.getElementById('authSubTitle').innerText = "আপনার একাউন্টে প্রবেশ করুন";
        }

        let tempRegData = {};

        function handleRegister() {
            const name = document.getElementById('regName').value;
            const phone = document.getElementById('regPhone').value;
            const pass = document.getElementById('regPass').value;

            if(!name || !phone || !pass) { alert("সব ফিল্ড পূরণ করুন!"); return; }
            if(phone.length < 11) { alert("সঠিক মোবাইল নম্বর দিন!"); return; }

            tempRegData = {name, phone, pass};
            generatedOtp = Math.floor(1000 + Math.random() * 9000).toString();
            document.getElementById('displayOtpCode').innerText = generatedOtp;

            document.getElementById('registerForm').classList.add('hidden');
            document.getElementById('otpForm').classList.remove('hidden');
            document.getElementById('authSubTitle').innerText = "ওটিপি ভেরিফিকেশন করুন";
            alert("আপনার মোবাইলে ওটিপি পাঠানো হয়েছে (স্ক্রিনে কোডটি দেখুন)");
        }

        function verifyOtp() {
            const entered = document.getElementById('enteredOtp').value;
            if(entered === generatedOtp) {
                localStorage.setItem('emon_user_phone', tempRegData.phone);
                localStorage.setItem('emon_user_name', tempRegData.name);
                localStorage.setItem('emon_user_pass', tempRegData.pass);
                alert("ওটিপি সফলভাবে ভেরিফাই হয়েছে! 🎉");
                startApp(tempRegData.name);
            } else {
                alert("ভুল ওটিপি কোড! আবার চেষ্টা করুন।");
            }
        }

        function handleLogin() {
            const phone = document.getElementById('loginPhone').value;
            const pass = document.getElementById('loginPass').value;
            const savedPhone = localStorage.getItem('emon_user_phone');
            const savedPass = localStorage.getItem('emon_user_pass');
            const savedName = localStorage.getItem('emon_user_name') || "Emon Player";

            if(!phone || !pass) { alert("নম্বর ও পাসওয়ার্ড দিন!"); return; }

            if((phone === savedPhone && pass === savedPass) || (phone === "01700000000" && pass === "1234")) {
                startApp(savedName);
            } else {
                alert("নম্বর বা পাসওয়ার্ড ভুল হয়েছে! দয়া করে রেজিস্ট্রেশন করে নিন।");
            }
        }

        function startApp(name) {
            localStorage.setItem('emon_logged_user', name);
            document.getElementById('authContainer').classList.add('hidden');
            document.getElementById('appContainer').classList.remove('hidden');
            document.getElementById('welcomeUser').innerText = `Welcome, ${name}`;
            updateWallet();
        }

        function handleLogout() {
            localStorage.removeItem('emon_logged_user');
            location.reload();
        }

        function switchTab(tab) {
            const tabs = ['games', 'deposit', 'withdraw', 'admin'];
            tabs.forEach(t => {
                document.getElementById('content-' + t).classList.add('hidden');
                const btn = document.getElementById('tab-' + t);
                btn.classList.remove('active', 'text-slate-950', 'font-bold');
                btn.classList.add('text-gray-300');
            });
            
            document.getElementById('content-' + tab).classList.remove('hidden');
            const activeBtn = document.getElementById('tab-' + tab);
            activeBtn.classList.add('active', 'text-slate-950', 'font-bold');
            activeBtn.classList.remove('text-gray-300');

            if(tab === 'admin') loadAdminData();
        }

        function updateWallet() {
            document.getElementById('userCoins').innerText = `🪙 ${coins} Coins`;
            let taka = (coins / 10).toFixed(2);
            document.getElementById('userTaka').innerText = `৳ ${taka} BDT`;
            localStorage.setItem('emon_coins', coins);
        }

        function spinWheel() {
            const rewards = [10, 20, 50, 100, 200, 500, 0, 30];
            const win = rewards[Math.floor(Math.random() * rewards.length)];
            coins += win;
            updateWallet();
            document.getElementById('spinResult').innerText = win > 0 ? `🎉 অভিনন্দন! আপনি ${win} কয়েন জিতেছেন!` : `😢 দুঃখিত! এই স্পিনে কিছু পাননি।`;
        }

        function claimBonus() {
            coins += 50;
            updateWallet();
            alert("সফলভাবে ৫০ কয়েন বোনাস ক্লেম করা হয়েছে! 🎉");
        }

        function requestDeposit() {
            const method = document.getElementById('depMethod').value;
            const sender = document.getElementById('depSenderNum').value;
            const amount = parseInt(document.getElementById('depAmount').value);
            const trxId = document.getElementById('depTrxId').value;

            if(!sender || !amount || !trxId) { alert("সব তথ্য সঠিকভাবে পূরণ করুন!"); return; }

            let deposits = JSON.parse(localStorage.getItem('emon_deposits') || '[]');
            deposits.push({method, sender, amount, trxId, time: new Date().toLocaleTimeString()});
            localStorage.setItem('emon_deposits', JSON.stringify(deposits));

            alert("ডিপোজিট রিকোয়েস্ট জমা হয়েছে! অ্যাডমিন যাচাই করে ব্যালেন্স যোগ করবেন।");
            document.getElementById('depSenderNum').value = '';
            document.getElementById('depAmount').value = '';
            document.getElementById('depTrxId').value = '';
        }

        function requestWithdraw() {
            const method = document.getElementById('payMethod').value;
            const number = document.getElementById('payNumber').value;
            const reqCoins = parseInt(document.getElementById('payCoins').value);

            if(!number || !reqCoins) { alert("সব তথ্য সঠিকভাবে পূরণ করুন!"); return; }
            if(reqCoins < 1000) { alert("ন্যূনতম ১০০০ কয়েন লাগবে!"); return; }
            if(reqCoins > coins) { alert("পর্যাপ্ত কয়েন নেই!"); return; }

            coins -= reqCoins;
            updateWallet();

            let withdraws = JSON.parse(localStorage.getItem('emon_withdraws') || '[]');
            withdraws.push({method, number, coins: reqCoins, taka: reqCoins/10, time: new Date().toLocaleTimeString()});
            localStorage.setItem('emon_withdraws', JSON.stringify(withdraws));

            alert("উইথড্র রিকোয়েস্ট সফলভাবে জমা হয়েছে!");
        }

        function loadAdminData() {
            let deposits = JSON.parse(localStorage.getItem('emon_deposits') || '[]');
            const depBox = document.getElementById('adminDeposits');
            depBox.innerHTML = deposits.length === 0 ? "কোনো ডিপোজিট রিকোয়েস্ট নেই।" : deposits.map((d, i) => `
                <div class="bg-slate-900 p-2 rounded border border-slate-800 flex justify-between items-center">
                    <div><b class="text-amber-400">${d.method}</b> (${d.sender})<br>টাকা: ৳${d.amount} | Trx: <span class="text-sky-300">${d.trxId}</span></div>
                    <button onclick="approveDep(${i}, ${d.amount})" class="bg-amber-500 text-slate-950 px-2 py-1 rounded font-bold text-[10px]">অনুমোদন ✅</button>
                </div>
            `).join('');

            let withdraws = JSON.parse(localStorage.getItem('emon_withdraws') || '[]');
            const witBox = document.getElementById('adminWithdraws');
            witBox.innerHTML = withdraws.length === 0 ? "কোনো উইথড্র রিকোয়েস্ট নেই।" : withdraws.map((w, i) => `
                <div class="bg-slate-900 p-2 rounded border border-slate-800 flex justify-between items-center">
                    <div><b class="text-emerald-400">${w.method}</b>: ${w.number}<br>পরিমাণ: ${w.coins} কয়েন (৳${w.taka})</div>
                    <button onclick="removeWit(${i})" class="bg-emerald-600 text-slate-950 px-2 py-1 rounded font-bold text-[10px]">পেইড ✅</button>
                </div>
            `).join('');
        }

        function approveDep(index, amount) {
            let deposits = JSON.parse(localStorage.getItem('emon_deposits') || '[]');
            coins += amount * 10;
            updateWallet();
            deposits.splice(index, 1);
            localStorage.setItem('emon_deposits', JSON.stringify(deposits));
            loadAdminData();
            alert("ডিপোজিট অ্যাপ্রুভ হয়েছে এবং কয়েন যোগ হয়েছে!");
        }

        function removeWit(index) {
            let withdraws = JSON.parse(localStorage.getItem('emon_withdraws') || '[]');
            withdraws.splice(index, 1);
            localStorage.setItem('emon_withdraws', JSON.stringify(withdraws));
            loadAdminData();
            alert("পেমেন্ট কমপ্লিট ঘোষণা করা হয়েছে!");
        }

        function clearData() {
            if(confirm("সব ডাটা রিসেট করতে চান?")) {
                localStorage.clear();
                location.reload();
            }
        }
    </script>
</body>
</html>